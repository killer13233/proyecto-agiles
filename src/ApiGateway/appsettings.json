{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },

  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8090"
      }
    }
  },

  "ReverseProxy": {
    "Routes": {
      "ruta-auth": {
        "ClusterId": "cluster-a",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "ruta-usuarios": {
        "ClusterId": "cluster-a",
        "Match": {
          "Path": "/api/usuarios/{**catch-all}"
        }
      },

      "ruta-alertas": {
        "ClusterId": "cluster-b",
        "Match": {
          "Path": "/api/alertas/{**catch-all}"
        }
      },
 
      "ruta-alertas-root": {
        "ClusterId": "cluster-b",
        "Match": {
          "Path": "/api/alertas"
        }
      },


      "ruta-ws": {
        "ClusterId": "cluster-b",
        "Match": {
          "Path": "/ws/{**catch-all}"
        }
      },

      "ruta-ws-root": {
        "ClusterId": "cluster-b",
        "Match": {
          "Path": "/ws"
        }
      },

      "ruta-zonas": {
        "ClusterId": "cluster-c",
        "Match": {
          "Path": "/api/zonas/{**catch-all}"
        }
      },

      "ruta-gruposconfianza": {
        "ClusterId": "cluster-a",
        "Match": {
          "Path": "/api/gruposconfianza/{**catch-all}"
        }
      },

      "ruta-gruposconfianza-root": {
        "ClusterId": "cluster-a",
        "Match": {
          "Path": "/api/gruposconfianza"
        }
      }
    },

    "Clusters": {
      "cluster-a": {
        "Destinations": {
          "dest-a": {
            "Address": "http://microservicio-a:8081/"
          }
        }
      },

      "cluster-b": {
        "Destinations": {
          "dest-b": {
            "Address": "http://microservicio-b:8082/"
          }
        }
      },

      "cluster-c": {
        "Destinations": {
          "dest-c": {
            "Address": "http://microservicio-c:8083/"
          }
        }
      }
    }
  }
}