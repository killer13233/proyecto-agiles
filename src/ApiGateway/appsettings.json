{
  "Logging": { "LogLevel": { "Default": "Information" } },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8090"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ruta-auth": {
        "ClusterId": "cluster-a",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "ruta-usuarios": {
        "ClusterId": "cluster-a",
        "Match": { "Path": "/api/usuarios/{**catch-all}" }
      },
      "ruta-alertas": {
        "ClusterId": "cluster-b",
        "Match": { "Path": "/api/alertas/{**catch-all}" }
      },
      "ruta-ws": {
        "ClusterId": "cluster-b",
        "Match": { "Path": "/ws" }
      },
      "ruta-zonas": {
        "ClusterId": "cluster-c",
        "Match": { "Path": "/api/zonas/{**catch-all}" }
      }
    },
    "Clusters": {
      "cluster-a": {
        "Destinations": {
          "dest-a": { "Address": "http://localhost:8081/" }
        }
      },
      "cluster-b": {
        "Destinations": {
          "dest-b": { "Address": "http://localhost:8082/" }
        }
      },
      "cluster-c": {
        "Destinations": {
          "dest-c": { "Address": "http://localhost:8083/" }
        }
      }
    }
  }
}